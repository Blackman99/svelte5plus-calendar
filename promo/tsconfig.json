{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"paths": { "svelte5plus-calendar": ["../src/lib"] },
		"types": ["svelte", "vite/client"],
		"strict": true,
		"noEmit": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true
	},
	"include": ["src/**/*.ts", "src/**/*.svelte"]
}
