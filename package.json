{
	"name": "svelte5plus-calendar",
	"version": "0.4.0",
	"description": "A full-featured, zero-dependency calendar component for Svelte 5 — month/week/day/year/agenda views, drag & drop, recurring events, i18n and dark mode.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Blackman99/svelte5plus-calendar.git"
	},
	"homepage": "https://blackman99.github.io/svelte5plus-calendar/",
	"bugs": {
		"url": "https://github.com/Blackman99/svelte5plus-calendar/issues"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@changesets/cli": "^3.0.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^26.2.0",
		"@types/prismjs": "^1.26.6",
		"prism-svelte": "^0.5.0",
		"prismjs": "^1.30.0",
		"publint": "^0.3.21",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	},
	"keywords": [
		"svelte",
		"svelte5",
		"calendar",
		"scheduler",
		"event-calendar",
		"date",
		"datepicker",
		"fullcalendar",
		"month-view",
		"week-view",
		"agenda",
		"rrule",
		"i18n"
	]
}
