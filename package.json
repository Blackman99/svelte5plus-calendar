{
	"name": "svelte5plus-calendar",
	"type": "module",
	"version": "0.5.2",
	"description": "A full-featured, zero-dependency calendar component for Svelte 5 — month/week/day/year/agenda views, drag & drop, recurring events, i18n and dark mode.",
	"license": "MIT",
	"homepage": "https://blackman99.github.io/svelte5plus-calendar/",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Blackman99/svelte5plus-calendar.git"
	},
	"bugs": {
		"url": "https://github.com/Blackman99/svelte5plus-calendar/issues"
	},
	"keywords": [
		"svelte",
		"svelte5",
		"calendar",
		"scheduler",
		"event-calendar",
		"date",
		"datepicker",
		"fullcalendar",
		"month-view",
		"week-view",
		"agenda",
		"rrule",
		"i18n"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"types": "./dist/index.d.ts",
	"files": [
		"!dist/**/*.spec.*",
		"!dist/**/*.test.*",
		"dist"
	],
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"deps:check": "taze",
		"deps:update": "taze minor -w && npm install"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@antfu/eslint-config": "^9.3.0",
		"@changesets/cli": "^3.0.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@types/node": "^26.2.0",
		"@types/prismjs": "^1.26.6",
		"eslint": "^10.8.1",
		"eslint-plugin-svelte": "^3.23.0",
		"prism-svelte": "^0.5.0",
		"prismjs": "^1.30.0",
		"publint": "^0.3.23",
		"svelte": "^5.56.9",
		"svelte-check": "^4.7.6",
		"svelte-eslint-parser": "^1.8.1",
		"taze": "^20.0.2",
		"typescript": "^6.0.3",
		"vite": "^8.2.1",
		"vitest": "^4.1.10"
	}
}
